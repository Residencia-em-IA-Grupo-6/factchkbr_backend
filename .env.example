# Configurações da Aplicação
APP_NAME="FactChkBR API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Analisadores ativos separados por vírgula
ACTIVE_ANALYZERS="claim_extractor,heuristic,fact_check_api,llm_judge"

# Provedor LLM (Padrão: ollama local sem custos; ou 'openai')
LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:9b"

# Credenciais de APIs Externas (Opcionais)
GOOGLE_FACTCHECK_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# Integração com Bot do Telegram (Recebimento de Updates e Entrega de Mensagens)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_WEBHOOK_SECRET="seu_token_secreto_opcional"
TELEGRAM_API_BASE_URL="https://api.telegram.org"
TELEGRAM_AUTO_REPLY=true


